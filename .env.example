# アプリケーション設定
APP_NAME="動画付き自己紹介プラットフォーム"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ログ設定
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# データベース設定
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=movie_prf
DB_USERNAME=root
DB_PASSWORD=root

# ブロードキャスト設定
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis設定（Phase 2で使用）
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# メール設定（Phase 2で使用）
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3設定（ローカルはMinIO）
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=videos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# 動画処理設定
VIDEO_MAX_SIZE=102400
VIDEO_MAX_DURATION=60
VIDEO_ALLOWED_MIMES=mp4,mov,avi,wmv
