# ===========================================
# アプリケーション設定
# ===========================================
APP_NAME="動画プロフィール(Laravel版)"
APP_ENV=local                    # 本番: production
APP_KEY=
APP_DEBUG=true                   # 本番: false
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost         # 本番(EC2単体): https://hozu.click
                                 # 本番(ALB構成): https://hozu.click
TRUSTED_PROXIES=                 # 本番(ALB構成): *  ※ALBのX-Forwarded-Protoを信頼するために必要

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

# ===========================================
# ログ設定
# ===========================================
LOG_CHANNEL=stack
LOG_LEVEL=debug                  # 本番: error

# ===========================================
# データベース設定
# ===========================================
DB_CONNECTION=mysql
DB_HOST=db                       # 本番: <RDSエンドポイント>
DB_PORT=3306
DB_DATABASE=movie_prf
DB_USERNAME=root                 # 本番: <DBユーザー名>
DB_PASSWORD=root                 # 本番: <DBパスワード>

# ===========================================
# ドライバ設定
# ===========================================
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local            # 本番: s3
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false      # 本番(ALB構成): true  ※HTTPS経由のみCookie送信
SESSION_DOMAIN=                  # 本番(ALB構成): <ドメイン名>  ※例: hozu.click

# ===========================================
# AWS S3設定
# ===========================================
# ローカル: MinIOを使用
# 本番: IAMロールを使用するため空欄でOK
AWS_ACCESS_KEY_ID=minioadmin     # 本番: （空欄）
AWS_SECRET_ACCESS_KEY=minioadmin # 本番: （空欄）
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=videos                # 本番: <S3バケット名>
AWS_URL=http://localhost:9000/videos  # 本番: （削除または空欄）
AWS_ENDPOINT=http://minio:9000   # 本番: （削除または空欄）
AWS_USE_PATH_STYLE_ENDPOINT=true # 本番: false

# ===========================================
# メール設定
# ===========================================
# ローカル: log（storage/logs/laravel.logに出力）
# 本番: ses（AWS SES経由で送信）
MAIL_MAILER=log                              # 本番: ses
MAIL_FROM_ADDRESS=noreply@hozu.click
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# デモ動画設定
# ===========================================
# ランディングページのデモカードで使用するサンプル動画のURL
# 本番: S3の公開URL（例: https://s3.ap-northeast-1.amazonaws.com/<bucket>/demo.mp4）
DEMO_VIDEO_URL=/cat-work.mp4

# ===========================================
# FFmpeg設定
# ===========================================
FFMPEG_PATH=/usr/bin/ffmpeg

# ===========================================
# チャットボット設定（AWS Bedrock）
# ===========================================
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# ローカル: .envにAWSクレデンシャルを設定
# 本番: IAMロールを使用するため空欄でOK
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=ap-northeast-1

# ===========================================
# チャットボット用PostgreSQL設定
# ===========================================
DB_CHATBOT_CONNECTION=pgsql_chatbot
DB_CHATBOT_HOST=postgres            # 本番: <RDS Postgresエンドポイント>
DB_CHATBOT_PORT=5432
DB_CHATBOT_DATABASE=chatbot
DB_CHATBOT_USERNAME=chatbot
DB_CHATBOT_PASSWORD=secret           # 本番: <DBパスワード>
