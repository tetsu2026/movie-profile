# デプロイ用環境変数テンプレート
#
# 使用方法:
#   1. このファイルをコピーして .env.deploy を作成
#      cp .env.deploy.example .env.deploy
#   2. .env.deploy の値を設定
#   3. 環境変数をロード
#      source .env.deploy
#   4. デプロイ実行
#      ./deploy.sh
#
# 注意: .env.deploy はGit管理対象外です（.gitignoreに追加済み）

# SSH接続を許可するIPアドレス（CIDR形式）
# 現在のIPを確認: curl ifconfig.me
export ADMIN_IP="<あなたのIPアドレス>/32"

# EC2キーペア名（AWSコンソールで作成したキーペア名）
export KEY_PAIR_NAME="<キーペア名>"

# RDSマスターユーザー名（推測されにくい名前を推奨）
export DB_USERNAME="<DBユーザー名>"

# RDSマスターパスワード（8文字以上、英数字と記号を含む強力なパスワード）
export DB_PASSWORD="<DBパスワード>"

# S3バケット名のサフィックス（一意になるよう日付やランダム文字列）
export BUCKET_SUFFIX="<一意のサフィックス>"
